      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccourcis clavier"
          }
        }
      }
    },
    "Hover over an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Survolez une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        }
      }
    },
    "Items can also be arranged by ⌘ Command + dragging them in the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi maintenir la touche « ⌘ Command » enfoncée en les faisant glisser directement dans la barre des menus."
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir à la connexion"
          }
        }
      }
    },
    "Language": {
