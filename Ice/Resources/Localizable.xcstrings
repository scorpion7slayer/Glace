      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir une image…"
          }
        }
      }
    },
    "Click inside an empty area of the menu bar to show hidden menu bar items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez dans une zone vide de la barre des menus pour afficher les éléments masqués."
          }
        }
      }
    },
    "Click to review detected menu bar items. Right-click to access Glace's settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour voir les éléments détectés. Faites un clic droit pour accéder aux réglages de Glace."
          }
        }
      }
    },
    "Click to show hidden menu bar items. Right-click to access Glace's settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez pour afficher les éléments masqués. Faites un clic droit pour accéder aux réglages de Glace."
          }
        }
      }
    },
