      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifier l'apparence de la barre des menus."
          }
        }
      }
    },
    "Changes are applied immediately.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont appliquées immédiatement."
          }
        }
      }
    },
    "Check for Updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les mises à jour"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les mises à jour…"
          }
        }
      }
