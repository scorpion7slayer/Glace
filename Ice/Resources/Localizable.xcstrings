    "About Glace": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À propos de Glace"
          }
        }
      }
    },
    "Absolutely no personal information is collected or stored.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune information personnelle n'est collectée ni stockée."
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibilité"
          }
        }
      }
    },
    "Accessibility permission is required to detect menu bar items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation Accessibilité est requise pour détecter les éléments de la barre des menus."
          }
        }
      }
    },
    "Acknowledgements": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remerciements"
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "Always-Hidden": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours masqué"
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer"
          }
        }
      }
    },
    "Apply different settings based on the current system appearance.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Applique des réglages différents à la barre des menus en fonction de l'apparence actuelle du système (clair ou sombre). "
          }
        }
      }
    },
    "Apply the current spacing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer l’espacement actuel"
          }
        }
      }
    },
    "Applying this setting will relaunch all apps with menu bar items. Some apps may need to be manually relaunched.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’application de ce réglage relancera toutes les apps possédant des éléments dans la barre des menus. Certaines apps devront peut-être être relancées manuellement."
          }
        }
      }
    },
    "Approve Glace in System Settings when prompted.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Glace dans Réglages Système lorsque macOS le demande."
          }
        }
      }
    },
    "Apps add their own menu bar items. Choose which system items appear from Menu Bar settings, and use the double arrow to access overflow items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apps ajoutent elles-mêmes leurs éléments à la barre des menus. Choisissez les éléments système visibles dans les réglages Barre des menus et utilisez la double flèche pour accéder aux éléments en surplus."
          }
        }
      }
    },
    "Arrange menu bar items.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réorganiser les éléments de la barre des menus selon vos préférences."
          }
        }
      }
    },
    "Automatically check for updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier automatiquement les mises à jour"
          }
        }
      }
    },
    "Automatically download updates": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger automatiquement les mises à jour"
          }
        }
      }
    },
    "Automatically rehide": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer automatiquement les icônes dévoilées"
          }
        }
      }
    },
