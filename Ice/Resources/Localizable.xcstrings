      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les menus des apps lors de l'affichage des éléments de la barre des menus"
          }
        }
      }
    },
    "Hold to Preview": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenir pour prévisualiser"
          }
        }
      }
    },
    "Hotkey is reserved by macOS": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce raccourci clavier est affecté à macOS"
          }
        }
      }
    },
