    "Location": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emplacement"
          }
        }
      }
    },
    "Make more room in the menu bar by hiding the current app menus if needed. macOS requires Glace to make itself visible in the Dock while this setting is in effect.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer de l'espace dans la barre des menus en masquant, si nécessaire, les menus de l'app active. macOS exige que Glace soit visible dans le Dock tant que ce réglage est activé."
          }
        }
      }
    },
    "Menu Bar Appearance": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apparence de la barre des menus"
          }
        }
      }
    },
    "Menu Bar Settings…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages Barre des menus…"
          }
        }
      }
    },
    "Menu Bar Items": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Éléments de la barre des menus"
          }
        }
      }
    },
    "Menu Bar Layout": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disposition de la barre des menus"
          }
        }
      }
    },
    "Menu Bar Sections": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sections de la barre des menus"
          }
        }
      }
