    "Chevron": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chevron"
          }
        }
      }
    },
    "Choose a custom icon to show in the menu bar.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir l’icône à afficher dans la barre des menus."
